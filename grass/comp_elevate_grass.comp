#version 460

layout(local_size_x = 256) in;

struct Instance {
    mat4 model;
    mat4 norm;
    // legacy per-instance params from the repo:
    // x = k1, y = k2, z = lambda, w = drag
    vec4 bend;
};

layout(std430, set = 0, binding = 0) buffer buff_grass_instanceinfo {
    Instance instances[];
};

layout(binding = 1) uniform sampler2D img_terrain;
layout(binding = 2) uniform Cfg{
    uint numOfInstances;
    float ground_size;
};

void main() {

    uint gid = gl_GlobalInvocationID.x;
    if(gid >= numOfInstances) return;

    vec2 p = instances[gid].model[3].xz;
    vec2 uv = 0.5*p/ground_size + 0.5;

    float h = texture(img_terrain, uv).x;

    instances[gid].model[3].y = h;
}