#version 460
#pragma stage(vertex)

layout(binding = 0) uniform Cfg{
    mat4 invV;
    vec3 farCorner;
};

layout(location = 0) out vec3 rd;

void main() {

    const vec2 pos[6] = vec2[](
        vec2(-1.0, -1.0),
        vec2( 1.0, -1.0),
        vec2(-1.0,  1.0),
        vec2(-1.0,  1.0),
        vec2( 1.0, -1.0),
        vec2( 1.0,  1.0)
    );


    gl_Position = vec4(pos[gl_VertexIndex], 0, 1.0);
    rd = (invV * vec4(farCorner * vec3(gl_Position.xy, 1.0), 1.0)).xyz;
}

#pragma stage(fragment)
#define PI 3.141592653589793238462643383279502884197

layout(binding = 1) uniform sampler2D img_env;

layout(location = 0) in vec3 rd;
layout(location = 0) out vec4 fragColor;

vec2 dir2uv(vec3 v){

    vec2 uv = vec2(atan(v.z, v.x), asin(-v.y));
    uv *= vec2(-1/(2*PI), 1/PI); //to invert atan
    uv += 0.5;
    return uv;
}

void main() {

    gl_FragDepth = 0.9999999;

    vec3 V = normalize(rd);
    vec2 uv = dir2uv(V);
    vec3 env = texture(img_env, uv).rgb;
    fragColor = vec4(env, 1);
}
