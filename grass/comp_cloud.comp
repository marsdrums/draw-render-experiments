#version 460
#extension GL_GOOGLE_include_directive : require
#include "c74.noise.funcs.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(r32f, binding = 0) uniform writeonly image2D img_cloud;

layout(binding = 1) uniform Cfg {
    float time;
    float scale;
};


void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(img_cloud);
    if (gid.x >= size.x || gid.y >= size.y) return;

    float scrollSpeed = length(vec2(0.06, 0.04));

    vec2 uv = vec2(gid) / vec2(size);

    vec2 p2 = uv * scale + scrollSpeed*time;
    vec3 p3 = vec3(p2.x, p2.y, time*0.01);
    
    float val = Normalize(fBmA(p3, 0.5, 2., 1., 7));
    val = smoothstep(0.6, 0.9, val);

    imageStore(img_cloud, gid, vec4(val));
}