#version 460
#pragma stage(vertex)

layout(set = 0, binding = 0) uniform Constants {
    mat4 mvp;
};

layout(location = 0) in vec4 position;

void main() {

    gl_Position = mvp * position;
}

#pragma stage(fragment)

layout(location = 0) out vec4 fragColor;

void main() {

    fragColor.rgb = vec3(0.11, 0.09, 0.01)*0.15;
    fragColor.a = 1.0;
}