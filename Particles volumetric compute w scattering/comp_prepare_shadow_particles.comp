#version 460

#extension GL_GOOGLE_include_directive : require
#include "c74.noise.funcs.glsl"

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
    vec2    _pad0;
    vec3    prevPos;
    float   _pad1;
};

struct DrawParticle{
    vec4 clipCenter;
    vec4 prevClipCenter;
    vec4 lightClipCenter;
    // x = radius, y = unused, z = inside flag, w = light-space AABB slice index
    vec4 data;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

// Sorted draw order. Values are indices into buff_particles.
layout(std430, set = 0, binding = 1) readonly buffer buff_sorted_indices {
    uint sortedIndices[];
};

layout(std430, set = 0, binding = 2) writeonly buffer buff_particle_draw {
    DrawParticle drawParticles[];
};

// x = lightMin, y = lightMax, z = invRange, w = unused.
layout(std430, set = 0, binding = 3) readonly buffer buff_light_slice_range {
    vec4 lightSliceRange;
};

layout(set = 0, binding = 4) uniform Constants {
    mat4 VP;
    float ALPHA;
    vec3 lightDir;
};

layout(binding = 5) uniform Cfg {
    uint COUNT;
    uint SLICE_SIZE;
} pc;

layout(binding = 6) uniform SliceParams {
    uint DENSITY_WORD_COUNT;
    uint DENSITY_BITS_PER_WORD;
    uint DENSITY_SLICE_COUNT;
};

uint lightSliceForPosition(vec3 pos)
{
    float lightMin = lightSliceRange.x;
    float invRange = lightSliceRange.z;
    float t = clamp((dot(lightDir, pos) - lightMin) * invRange, 0.0, 1.0);
    return min(DENSITY_SLICE_COUNT - 1u, uint(t * float(DENSITY_SLICE_COUNT - 1u) + 0.5));
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.COUNT) return;

    // The permutation is now purely camera-front-to-back. Slice membership is
    // independent of sorted position and comes from the AABB projected on lightDir.
    uint particleIndex = sortedIndices[gid];
    Particle p = particles[particleIndex];

    DrawParticle d;
    d.clipCenter = VP * vec4(p.pos, 1.0);
    d.prevClipCenter = vec4(0.0);
    d.lightClipCenter = vec4(0.0);
    d.data = vec4(p.rad, 0.0, 1.0, float(lightSliceForPosition(p.pos)));
    drawParticles[gid] = d;
}
