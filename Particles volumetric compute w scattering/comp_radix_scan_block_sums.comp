#version 460

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer buff_radix_block_sums {
    uint blockSums[];
};

layout(std430, set = 0, binding = 1) buffer buff_radix_block_offsets {
    uint blockOffsets[];
};

shared uint temp[256];

void main() {
    uint lid = gl_LocalInvocationID.x;

    temp[lid] = blockSums[lid];
    barrier();

    for (uint offset = 1u; offset < 256u; offset <<= 1u) {
        uint index = ((lid + 1u) << 1u) * offset - 1u;
        if (index < 256u) {
            temp[index] += temp[index - offset];
        }
        barrier();
    }

    if (lid == 0u) {
        temp[255] = 0u;
    }
    barrier();

    for (uint offset = 128u; offset > 0u; offset >>= 1u) {
        uint index = ((lid + 1u) << 1u) * offset - 1u;
        if (index < 256u) {
            uint t = temp[index - offset];
            temp[index - offset] = temp[index];
            temp[index] += t;
        }
        barrier();
    }

    blockOffsets[lid] = temp[lid];
}
