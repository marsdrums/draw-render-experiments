#version 460

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer buff_radix_bin_offsets {
    uint binOffsets[];
};

layout(std430, set = 0, binding = 1) readonly buffer buff_radix_block_offsets {
    uint blockOffsets[];
};

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x;
    uint gid = block * 256u + lid;

    binOffsets[gid] += blockOffsets[block];
}
