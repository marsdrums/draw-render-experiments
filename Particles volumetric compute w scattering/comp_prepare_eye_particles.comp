#version 460
#extension GL_GOOGLE_include_directive : require
#include "c74.noise.funcs.glsl"

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
    vec2    _pad0;
    vec3    prevPos;
    float   _pad1;
};

struct DrawParticle{
    vec4 clipCenter;
    // Eye path: xyz = precomputed shaded particle color, w = inside/visible flag.
    // Shadow path reuses this slot differently before the draw buffer is rewritten.
    vec4 data;
    // x/y = motion-blur capsule center in aspect-corrected NDC metric space,
    // z/w = unit motion axis in that same metric space.
    vec4 motionData0;
    // x = radius in aspect-corrected NDC metric space,
    // y = along-axis quad extent,
    // z = capsule half-length in particle-radius units,
    // w = energy-conserving alpha compensation.
    vec4 motionData1;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

// Sorted draw order. Values are indices into buff_particles.
layout(std430, set = 0, binding = 1) readonly buffer buff_sorted_indices {
    uint sortedIndices[];
};

// Slice occupancy map. Width is tiled by 32-bit words; each bit is one light-space slice.
layout(r32ui, binding = 2) uniform uimage2D img_density_map;

// Same tiling as img_density_map. Each word stores the number of occupied
// slices in all previous 32-bit words for that logical shadow-map pixel.
layout(r32ui, binding = 8) uniform uimage2D img_density_prefix_count_map;

// One uint per logical shadow-map pixel. Value is the closest-to-light
// occupied slice, or DENSITY_SLICE_COUNT when the light ray is empty.
layout(r32ui, binding = 7) uniform uimage2D img_first_blocked_slice_map;

layout(std430, set = 0, binding = 3) writeonly buffer buff_particle_draw {
    DrawParticle drawParticles[];
};

// x = lightMin, y = lightMax, z = invRange, w = unused.
layout(std430, set = 0, binding = 4) readonly buffer buff_light_slice_range {
    vec4 lightSliceRange;
};

// Filtered irradiance / AO cache stored in a 3D texture. Depth is doubled
// for ping-pong history: one half is the previous filtered cache, the other is current.
layout(binding = 9) uniform sampler3D img_ambient_occlusion_cache;

// Decoded particle AABB, computed once per frame by comp_compute_light_slice_range.comp.
layout(std430, set = 0, binding = 10) readonly buffer buff_particle_aabb {
    vec4 particleAabbMin;
    vec4 particleAabbMax;
};

// GPU-fitted light projection matrices, generated once per frame from the reduced AABB.
layout(std430, set = 0, binding = 11) readonly buffer buff_light_matrices {
    mat4 lightP;
    mat4 lightVP;
};

layout(set = 0, binding = 5) uniform Constants {
    mat4 VP;
    mat4 P;
    vec3 lightDir;
    float ALPHA;
    float MOTION_BLUR_STRENGTH;
    float MOTION_BLUR_MAX_STRETCH;
    float ASPECT;
    uint DENSITY_WORD_COUNT;
    uint DENSITY_BITS_PER_WORD;
    uint DENSITY_SLICE_COUNT;
    float SHADOW_BLUR_SCALE;
    float opacityMultiplier;
    uint AMBIENT_OCCLUSION_CACHE_RESOLUTION;
    uint AMBIENT_OCCLUSION_CACHE_READ_Z_OFFSET;
    vec3 AMBIENT_LIGHT;
    vec4 LIGHT_COLOR;
};

layout(binding = 6) uniform Cfg {
    uint COUNT;
    uint SLICE_SIZE;
} pc;

shared ivec2 logicalSize;
shared vec2 fsize;
shared float lightMin;
shared float invRange;
shared vec3 aabbMin;
shared vec3 aabbMax;


ivec2 densityPixelCoord(ivec2 logicalPixel, uint wordIndex, ivec2 logicalSize)
{
    return ivec2(logicalPixel.x + int(wordIndex) * logicalSize.x, logicalPixel.y);
}

uint loadDensityWord(ivec2 logicalPixel, uint wordIndex, ivec2 logicalSize)
{
    ivec2 tiledPixel = densityPixelCoord(logicalPixel, wordIndex, logicalSize);
    return imageLoad(img_density_map, tiledPixel).x;
}

uint lightSliceForPosition(vec3 pos)
{
    float t = clamp((dot(lightDir, pos) - lightMin) * invRange, 0.0, 1.0);
    return min(DENSITY_SLICE_COUNT - 1u, uint(t * float(DENSITY_SLICE_COUNT - 1u) + 0.5));
}

uint loadPrefixCountBeforeWord(ivec2 logicalPixel, uint wordIndex, ivec2 logicalSize)
{
    ivec2 tiledPixel = densityPixelCoord(logicalPixel, wordIndex, logicalSize);
    return imageLoad(img_density_prefix_count_map, tiledPixel).x;
}

uint countPreviousBitsIn256Slices(ivec2 logicalPixel, uint eyeSlice, ivec2 logicalSize)
{
    if (eyeSlice == 0u) return 0u;

    eyeSlice = min(eyeSlice, DENSITY_SLICE_COUNT - 1u);

    uint currentWord = eyeSlice / DENSITY_BITS_PER_WORD;
    uint bitInWord   = eyeSlice & 31u;

    uint density = loadPrefixCountBeforeWord(logicalPixel, currentWord, logicalSize);

    if (bitInWord > 0u) {
        uint wordBits = loadDensityWord(logicalPixel, currentWord, logicalSize);
        uint previousBitsMask = (1u << bitInWord) - 1u;
        density += bitCount(wordBits & previousBitsMask);
    }

    return density;
}

bool isDensitySliceOccupied(ivec2 logicalPixel, uint slice, ivec2 logicalSize)
{
    slice = min(slice, DENSITY_SLICE_COUNT - 1u);

    uint wordIndex = slice / DENSITY_BITS_PER_WORD;
    uint bitIndex  = slice & 31u;
    uint wordBits  = loadDensityWord(logicalPixel, wordIndex, logicalSize);

    return (wordBits & (1u << bitIndex)) != 0u;
}

vec3 sampleAmbientOcclusionCache(vec3 worldPos)
{
    uint res = max(AMBIENT_OCCLUSION_CACHE_RESOLUTION, 1u);

    vec3 extent = max(aabbMax - aabbMin, vec3(1e-6));
    vec3 uvw = clamp((worldPos - aabbMin) / extent, vec3(0.0), vec3(1.0));

    // Convert local cache coordinates to texel-center-normalized coordinates.
    // X/Y dimensions are res, Z dimension is 2*res because the filtered cache
    // ping-pongs between the front and back halves of one 3D texture.
    float resf = float(res);
    float depthf = float(res * 2u);
    vec3 localTexel = uvw * float(res - 1u) + vec3(0.5);
    vec3 texCoord = vec3(localTexel.x / resf,
                         localTexel.y / resf,
                         (float(AMBIENT_OCCLUSION_CACHE_READ_Z_OFFSET) + localTexel.z) / depthf);

    return texture(img_ambient_occlusion_cache, texCoord).rgb;
}

void computeMotionBlurData(inout DrawParticle d, vec4 prevClipCenter, float particleRadius)
{
    float currentW = max(abs(d.clipCenter.w), 1e-6);
    vec2 currentNdc = d.clipCenter.xy / currentW;

    bool validPrev = abs(prevClipCenter.w) > 1e-6;
    vec2 previousNdc = validPrev ? (prevClipCenter.xy / prevClipCenter.w) : currentNdc;

    // Work in aspect-corrected NDC metric space. In this space, one unit in x
    // and y corresponds to the same screen/pixel distance.
    vec2 metricScale = vec2(max(ASPECT, 1e-6), 1.0);
    vec2 currentMetric = currentNdc * metricScale;
    vec2 previousMetric = mix(currentMetric,
                              previousNdc * metricScale,
                              clamp(MOTION_BLUR_STRENGTH, 0.0, 1.0));

    vec2 motion = currentMetric - previousMetric;
    float motionLength = length(motion);

    vec2 axis = (motionLength > 1e-7) ? (motion / motionLength) : vec2(1.0, 0.0);

    // Radius in the same aspect-corrected NDC metric. P[1].y is the vertical
    // projection scale, so radiusMetric is the current screen-space particle radius.
    float radiusMetric = max(abs(P[1].y) * particleRadius / currentW, 1e-7);

    float halfLength = 0.5 * motionLength;
    float maxHalfLength = max(MOTION_BLUR_MAX_STRETCH, 0.0) * radiusMetric;
    halfLength = min(halfLength, maxHalfLength);

    // The segment runs from the current position toward the previous position.
    // When unclamped, this exactly spans the two projected particle centers.
    vec2 centerMetric = currentMetric - axis * halfLength;

    float halfLengthInRadii = halfLength / radiusMetric;
    float alongExtent = halfLength + radiusMetric;

    // Keep the integrated emitted radiance stable as the particle is stretched.
    // The capsule uses alpha = (1 - r^2)^2, so the compensation follows the
    // integrated-alpha growth of that footprint rather than hard geometric area.
    float integratedAlphaStretch = 1.0 + (32.0 * halfLengthInRadii) / (5.0 * PI);
    float alphaCompensation = 1.0 / max(integratedAlphaStretch, 1e-6);

    d.motionData0 = vec4(centerMetric, axis);
    d.motionData1 = vec4(radiusMetric,
                         alongExtent,
                         halfLengthInRadii,
                         alphaCompensation);
}

uint sampleFirstBlockedSlice(vec3 projCoords)
{
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
        projCoords.y < 0.0 || projCoords.y > 1.0 ||
        projCoords.z > 1.0) {
        return DENSITY_SLICE_COUNT;
    }

    ivec2 firstSize = imageSize(img_first_blocked_slice_map);
    ivec2 logicalPixel = ivec2(vec2(firstSize) * projCoords.xy);
    logicalPixel = clamp(logicalPixel, ivec2(0), firstSize - ivec2(1));

    return imageLoad(img_first_blocked_slice_map, logicalPixel).x;
}

vec3 clipToTex(vec4 clipPos)
{
    vec3 projCoords = clipPos.xyz / clipPos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y;
    return projCoords;
}

float sampleShadow(vec3 projCoords, uint slice, vec2 offset)
{
    projCoords.xy += offset;

    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
        projCoords.y < 0.0 || projCoords.y > 1.0 ||
        projCoords.z > 1.0) {
        return 1.0;
    }

    ivec2 logicalPixel = ivec2(fsize * projCoords.xy);
    logicalPixel = clamp(logicalPixel, ivec2(0), logicalSize - ivec2(1));

    uint density = countPreviousBitsIn256Slices(logicalPixel, slice, logicalSize);
    return float(density);
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.COUNT) return;

    if (gl_LocalInvocationIndex == 0) {
        ivec2 fullSize = imageSize(img_density_map);
        logicalSize = ivec2(fullSize.x / int(DENSITY_WORD_COUNT), fullSize.y);
        fsize = vec2(logicalSize);
        lightMin = lightSliceRange.x;
        invRange = lightSliceRange.z;
        aabbMin = particleAabbMin.xyz;
        aabbMax = particleAabbMax.xyz;
    }

    barrier();

    uint particleIndex = sortedIndices[gid];
    Particle p = particles[particleIndex];

    uint slice = lightSliceForPosition(p.pos);
    if (slice > 0u) {
        slice -= 1u;
    }

    DrawParticle d;
    d.clipCenter = VP * vec4(p.pos, 1.0);
    vec4 prevClipCenter = VP * vec4(p.prevPos, 1.0);
    vec4 lightClipCenter = lightVP * vec4(p.pos, 1.0);

    vec3 uv = clipToTex(lightClipCenter);

    uint firstBlockedSlice = sampleFirstBlockedSlice(uv);
    uint sliceTravelAfterFirstBlocker = 0u;

    if (firstBlockedSlice < slice) {
        sliceTravelAfterFirstBlocker = slice - firstBlockedSlice;
    }

    float eps = float(sliceTravelAfterFirstBlocker) * SHADOW_BLUR_SCALE;

    uint seed = particleIndex + 9999u;

    float shadowDensity = 0.0;

    float numSamples = 4.0;
    for (int i = 0; i < int(numSamples); i++) {
        shadowDensity += sampleShadow(uv, slice, randomUnitVector2(seed) * eps);
    }
    shadowDensity /= numSamples;
    
    //shadowDensity = shadowDensity += sampleShadow(uv, slice, vec2(0.0));

    
    float directTransmittance = exp(-shadowDensity * opacityMultiplier);

    // Ambient occlusion is cached on a cubic probe grid over the particle AABB.
    // The expensive 3D occupancy sampling happens once per probe in
    // comp_build_ambient_occlusion_cache.comp; particles only trilinearly
    // interpolate the cached ambient visibility here.
    vec3 envColor = sampleAmbientOcclusionCache(p.pos);

    // Particle lighting is constant across the four quad vertices, so prepare it
    // once here and store the final shaded color in the draw payload.
    vec3 albedo = p.col.rgb;
    vec3 directLightColor = LIGHT_COLOR.rgb;
    vec3 shadedColor = albedo * (directLightColor * directTransmittance + envColor);
    d.data = vec4(shadedColor, 1.0);

    // Motion-blur geometry and alpha compensation are particle-wide values.
    // Compute them once here instead of repeating the work for all four quad vertices.
    computeMotionBlurData(d, prevClipCenter, p.rad);

    drawParticles[gid] = d;
}