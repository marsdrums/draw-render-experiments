#version 460

layout(local_size_x = 1) in;

// Current decoded particle AABB for this frame.
layout(std430, set = 0, binding = 0) readonly buffer buff_particle_aabb {
    vec4 particleAabbMin;
    vec4 particleAabbMax;
};

// AABB retained for temporal irradiance-cache reprojection in the next frame.
layout(std430, set = 0, binding = 1) writeonly buffer buff_previous_particle_aabb {
    vec4 previousParticleAabbMin;
    vec4 previousParticleAabbMax;
};

void main()
{
    previousParticleAabbMin = particleAabbMin;
    previousParticleAabbMax = particleAabbMax;
}
