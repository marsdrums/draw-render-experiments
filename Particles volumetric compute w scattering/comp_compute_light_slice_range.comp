#version 460

layout(local_size_x = 1) in;

struct AabbRecord {
    vec4 bmin;
    vec4 bmax;
};

// Final AABB is in one of these ping-pong buffers. AABB_REDUCTION_FINAL_IN_A selects it.
layout(std430, set = 0, binding = 0) readonly buffer buff_aabb_reduce_a {
    AabbRecord aabbReduceA[];
};

layout(std430, set = 0, binding = 1) readonly buffer buff_aabb_reduce_b {
    AabbRecord aabbReduceB[];
};

// x = lightMin, y = lightMax, z = invRange, w = unused.
layout(std430, set = 0, binding = 2) writeonly buffer buff_light_slice_range {
    vec4 lightSliceRange;
};

// Decoded particle AABB, shared by all later passes that need world-space bounds.
layout(std430, set = 0, binding = 3) writeonly buffer buff_particle_aabb {
    vec4 particleAabbMin;
    vec4 particleAabbMax;
};

// GPU-built tight orthographic light projection.
// lightP is used to estimate particle footprint in the light raster pass;
// lightVP is used everywhere that projects world positions into density-map space.
layout(std430, set = 0, binding = 4) writeonly buffer buff_light_matrices {
    mat4 lightP;
    mat4 lightVP;
};

layout(set = 0, binding = 5) uniform Constants {
    vec3 lightDir;
    uint AABB_REDUCTION_FINAL_IN_A;
    // World-space padding added around the projected light-space AABB.
    // This avoids clipping particle footprints exactly on the box boundary.
    float LIGHT_FIT_PADDING;
};

AabbRecord loadFinalAabb()
{
    if (AABB_REDUCTION_FINAL_IN_A != 0u) {
        return aabbReduceA[0];
    }
    return aabbReduceB[0];
}

mat4 makeLookAtFromBasis(vec3 eye, vec3 right, vec3 up, vec3 backward)
{
    // Matches the column-major matrix layout used by vector_math.js::lookAt().
    return mat4(
        vec4(right.x, up.x, backward.x, 0.0),
        vec4(right.y, up.y, backward.y, 0.0),
        vec4(right.z, up.z, backward.z, 0.0),
        vec4(-dot(right, eye), -dot(up, eye), -dot(backward, eye), 1.0)
    );
}

mat4 makeOrtho(float left, float right, float bottom, float top, float znear, float zfar)
{
    // Matches vector_math.js::ortho(): camera-space points in front of the
    // light camera have negative z, mapping -znear -> 0 and -zfar -> 1.
    float lr = 1.0 / max(abs(left - right), 1e-20) * sign(left - right);
    float bt = 1.0 / max(abs(bottom - top), 1e-20) * sign(bottom - top);
    float nf = 1.0 / max(abs(znear - zfar), 1e-20) * sign(znear - zfar);

    return mat4(
        vec4(-2.0 * lr, 0.0, 0.0, 0.0),
        vec4(0.0, -2.0 * bt, 0.0, 0.0),
        vec4(0.0, 0.0, nf, 0.0),
        vec4((left + right) * lr,
             (top + bottom) * bt,
             znear * nf,
             1.0)
    );
}

void main()
{
    AabbRecord record = loadFinalAabb();
    vec3 bmin = record.bmin.xyz;
    vec3 bmax = record.bmax.xyz;

    vec3 center = 0.5 * (bmin + bmax);
    vec3 extent = max(bmax - bmin, vec3(1e-6));

    float lightDirLength = length(lightDir);
    vec3 forward = lightDirLength > 1e-12
                 ? (lightDir / lightDirLength)
                 : normalize(vec3(-1.0, -1.0, -1.0));

    // The view matrix stores a "backward" camera axis, like the existing CPU lookAt().
    // The light camera looks along forward/lightDir, so backward = -forward.
    vec3 backward = -forward;
    vec3 upRef = abs(backward.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 rightAxis = normalize(cross(upRef, backward));
    vec3 upAxis = normalize(cross(backward, rightAxis));

    float lightMin =  3.402823466e+38;
    float lightMax = -3.402823466e+38;

    float xmin =  3.402823466e+38;
    float xmax = -3.402823466e+38;
    float ymin =  3.402823466e+38;
    float ymax = -3.402823466e+38;
    float zmin =  3.402823466e+38;
    float zmax = -3.402823466e+38;

    for (uint i = 0u; i < 8u; ++i) {
        vec3 c = vec3((i & 1u) != 0u ? bmax.x : bmin.x,
                      (i & 2u) != 0u ? bmax.y : bmin.y,
                      (i & 4u) != 0u ? bmax.z : bmin.z);

        float alongLight = dot(forward, c);
        lightMin = min(lightMin, alongLight);
        lightMax = max(lightMax, alongLight);

        vec3 delta = c - center;
        float lx = dot(rightAxis, delta);
        float ly = dot(upAxis, delta);
        float lz = dot(backward, delta);

        xmin = min(xmin, lx);
        xmax = max(xmax, lx);
        ymin = min(ymin, ly);
        ymax = max(ymax, ly);
        zmin = min(zmin, lz);
        zmax = max(zmax, lz);
    }

    float sceneScale = max(max(extent.x, extent.y), extent.z);
    float pad = max(max(LIGHT_FIT_PADDING, sceneScale * 0.005), 1e-5);

    float left   = xmin - pad;
    float right  = xmax + pad;
    float bottom = ymin - pad;
    float top    = ymax + pad;

    // Position the orthographic light camera just outside the nearest AABB face.
    // For this view convention, projected camera-space z is negative in front.
    float nearPlane = pad;
    float depthRange = max(zmax - zmin, 1e-5);
    float farPlane = nearPlane + depthRange + 2.0 * pad;
    float eyeDistance = zmax + nearPlane + pad;
    vec3 eye = center + backward * eyeDistance;

    mat4 lightV = makeLookAtFromBasis(eye, rightAxis, upAxis, backward);
    mat4 fittedLightP = makeOrtho(left, right, bottom, top, nearPlane, farPlane);
    mat4 fittedLightVP = fittedLightP * lightV;

    float invRange = 1.0 / max(lightMax - lightMin, 1e-20);
    lightSliceRange = vec4(lightMin, lightMax, invRange, 0.0);

    particleAabbMin = vec4(bmin, 0.0);
    particleAabbMax = vec4(bmax, 0.0);

    lightP = fittedLightP;
    lightVP = fittedLightVP;
}
