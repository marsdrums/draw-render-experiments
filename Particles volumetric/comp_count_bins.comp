#version 460

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) buffer buff_bin_counts {
    uint binCounts[];
};

layout(binding = 2) uniform Cfg {
    uint COUNT;
    uint BIN_COUNT;
    float KEY_MIN;
    float KEY_INV_RANGE;
};

uint key_to_bin(float key) {
    float t = clamp((key - KEY_MIN) * KEY_INV_RANGE, 0.0, 0.99999994);
    return min(uint(t * float(BIN_COUNT)), BIN_COUNT - 1u);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= COUNT) return;

    uint binIndex = key_to_bin(particles[gid].key);
    atomicAdd(binCounts[binIndex], 1u);
}
