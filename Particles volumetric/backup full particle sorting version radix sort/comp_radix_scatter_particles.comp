#version 460

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle srcParticles[];
};

layout(std430, set = 0, binding = 1) buffer buff_particles_tmp {
    Particle dstParticles[];
};

layout(std430, set = 0, binding = 2) readonly buffer buff_radix_bin_offsets {
    uint binOffsets[];
};

layout(std430, set = 0, binding = 3) buffer buff_radix_cursor {
    uint cursor[];
};

layout(binding = 4) uniform Cfg {
    uint COUNT;
    //vec3 HALF_VECTOR;
    float KEY_MIN;
    float KEY_INV_RANGE;
};

uint depth_to_key16(float projected) {
    float t = clamp((projected - KEY_MIN) * KEY_INV_RANGE, 0.0, 1.0);
    return uint(t * 65535.0 + 0.5);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= COUNT) return;

    Particle p = srcParticles[gid];
    //float projected = dot(HALF_VECTOR, p.pos);
    uint key = depth_to_key16(p.key);

    uint localIndexInBin = atomicAdd(cursor[key], 1u);
    uint sortedIndex = binOffsets[key] + localIndexInBin;

    //p.key = projected;
    dstParticles[sortedIndex] = p;
}
