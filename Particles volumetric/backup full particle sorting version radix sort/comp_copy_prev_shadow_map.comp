#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(r32f, binding = 0) uniform readonly image2D curr_shadow_map;
layout(r32f, binding = 1) uniform writeonly image2D prev_shadow_map;

void main() {

    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(curr_shadow_map);

    if(gid.x >= size.x || gid.y >= size.y) return;

    float val = imageLoad(curr_shadow_map, gid).x;
    imageStore(prev_shadow_map, gid, vec4(val));
}
