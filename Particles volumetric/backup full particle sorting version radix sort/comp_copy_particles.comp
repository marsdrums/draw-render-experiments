#version 460

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles_tmp {
    Particle srcParticles[];
};

layout(std430, set = 0, binding = 1) buffer buff_particles {
    Particle dstParticles[];
};

layout(binding = 2) uniform Cfg {
    uint COUNT;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= COUNT) return;

    dstParticles[gid] = srcParticles[gid];
}
