#version 460

#pragma stage(vertex)

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

layout(set = 0, binding = 1) uniform sampler2D img_shadow_map;
layout(set = 0, binding = 2) uniform sampler2D img_shadow_map_prev;
layout(set = 0, binding = 3) uniform sampler2D img_prev_slice;


layout(set = 0, binding = 4) uniform Constants {
    mat4 V;
    mat4 P;
    mat4 ligV;
    mat4 ligP;
    vec3 lightDir;
    float ALPHA;
    float test;
};

layout(location = 0) in vec4 offset;

layout(location = 0) out float shadow;
layout(location = 1) out vec2 corner;
layout(location = 2) out vec4 ligSpacePos;
layout(location = 3) out float inside;

float samplePrevSliceOpacity(vec3 projCoords)
{
    // Outside light frustum — no shadow
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
            projCoords.y < 0.0 || projCoords.y > 1.0 ||
            projCoords.z > 1.0) {
        return 1.0;
    }

    return texture(img_prev_slice, projCoords.xy).a;
}

float sampleShadow(vec3 projCoords, uint id)
{
    // Outside light frustum — no shadow
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
            projCoords.y < 0.0 || projCoords.y > 1.0 ||
            projCoords.z > 1.0) {
        return 1.0;
    }

    float randInterp = fract(float(id) * 999 * 1.618033988749894848204586834365638117720309);

    float shadow = texture(img_shadow_map, projCoords.xy).r;

    //shadow = mix(shadow, texture(img_shadow_map_prev, projCoords.xy).r, randInterp); // to remove the banding

    //float shadow = texture(img_shadow_map, projCoords.xy).r;

    return clamp(1.0 - shadow, 0.0, 1.0);
}

void main() {

    Particle p = particles[gl_InstanceIndex];
    corner = offset.xy;
    vec3 finalOffset = offset.xyz*p.rad;
    vec3 vPos = (V * vec4(p.pos, 1.0)).xyz;

    //opacity culling
    vec4 centerPos = P * vec4(vPos, 1.0);
    vec3 projCoords = centerPos.xyz / centerPos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y; // flip Y for texture coords
    float prevSliceOpacity = samplePrevSliceOpacity(projCoords);
    if(prevSliceOpacity >= 0.95){
        gl_Position = vec4(1000);
        shadow = 1.0;
        inside = 0.0;
    } else {

        gl_Position = P * vec4(vPos + finalOffset, 1.0);
        //shadowing
        vec3 vLigPos = (ligV * vec4(p.pos, 1.0)).xyz;
        ligSpacePos = ligP * vec4(vLigPos + finalOffset, 1.0);
        // Perspective divide + map to [0,1] UV space
        projCoords = ligSpacePos.xyz / ligSpacePos.w;
        projCoords.xy = projCoords.xy * 0.5 + 0.5;
        projCoords.y = 1.0 - projCoords.y; // flip Y for texture coords

        shadow = sampleShadow(projCoords, p.id);     
        inside = 1.0;  
    }
}

#pragma stage(fragment)

layout(location = 0) in float shadow;
layout(location = 1) in vec2 corner;
layout(location = 2) in vec4 ligSpacePos;
layout(location = 3) in float inside;

layout(location = 0) out vec4 fragColor;

layout(set = 0, binding = 4) uniform Constants {
    mat4 V;
    mat4 P;
    mat4 ligV;
    mat4 ligP;
    vec3 lightDir;
    float ALPHA;
};

void main()
{

    float r2 = dot(corner, corner);

    if(inside == 0 || r2 > 1.0){
        discard;
        return;
    }

    vec3 alb = vec3(0.8);

    float a = smoothstep(0.0, 1.0, 1.0 - r2) * ALPHA;
    vec3 col = alb * shadow;
    fragColor = vec4(col * a, a); //pre-multiplied alpha
}
