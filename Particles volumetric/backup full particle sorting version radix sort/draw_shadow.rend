#version 460

#pragma stage(vertex)

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

layout(set = 0, binding = 1) uniform sampler2D img_shadow_map_prev;

layout(set = 0, binding = 2) uniform Constants {
    mat4 V;
    mat4 P;
    float ALPHA;
};

layout(location = 0) in vec4 offset;

layout(location = 0) out vec2 corner;
layout(location = 1) out float inside;

float samplePrevSliceOpacity(vec3 projCoords)
{
    // Outside light frustum — no shadow
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
            projCoords.y < 0.0 || projCoords.y > 1.0 ||
            projCoords.z > 1.0) {
        return 1.0;
    }

    return texture(img_shadow_map_prev, projCoords.xy).r;
}


void main() {

    Particle p = particles[gl_InstanceIndex];
    corner = offset.xy;
    vec3 vPos = (V * vec4(p.pos, 1.0)).xyz;
    gl_Position = P * vec4(vPos + offset.xyz*p.rad, 1.0);
    inside = 1.0;

/*
    //opacity culling
    vec4 centerPos = P * vec4(vPos, 1.0);
    vec3 projCoords = centerPos.xyz / centerPos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y; // flip Y for texture coords
    float prevSliceOpacity = samplePrevSliceOpacity(projCoords);
    if(prevSliceOpacity >= 1.0){
        gl_Position = vec4(1000);
        inside = 0.0;
    } else {

        gl_Position = P * vec4(vPos + offset.xyz*p.rad, 1.0);
        inside = 1.0; 
    }
*/
}

#pragma stage(fragment)


layout(location = 0) in vec2 corner;
layout(location = 1) in float inside;

layout(location = 0) out vec4 fragColor;

layout(set = 0, binding = 2) uniform Constants {
    mat4 V;
    mat4 P;
    float ALPHA;
};

void main()
{

    float r2 = dot(corner, corner);
    if (inside == 0 || r2 > 1.0){
        discard;
        return;
    } 

    fragColor.rgb = vec3(1);
    fragColor.a = smoothstep(0.0, 1.0, 1.0 - r2) * ALPHA;
}
