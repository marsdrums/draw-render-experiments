#version 460

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

layout(std430, set = 0, binding = 1) readonly buffer buff_bin_offsets {
    uint binOffsets[];
};

layout(std430, set = 0, binding = 2) buffer buff_bin_write_counts {
    uint binWriteCounts[];
};

layout(std430, set = 0, binding = 3) writeonly buffer buff_bucket_indices {
    uint bucketIndices[];
};

layout(binding = 4) uniform Cfg {
    uint COUNT;
    uint BIN_COUNT;
    float KEY_MIN;
    float KEY_INV_RANGE;
};

uint key_to_bin(float key) {
    float t = clamp((key - KEY_MIN) * KEY_INV_RANGE, 0.0, 0.99999994);
    return min(uint(t * float(BIN_COUNT)), BIN_COUNT - 1u);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= COUNT) return;

    uint binIndex = key_to_bin(particles[gid].key);
    uint localIndex = atomicAdd(binWriteCounts[binIndex], 1u);
    uint dst = binOffsets[binIndex] + localIndex;

    bucketIndices[dst] = gid;
}
