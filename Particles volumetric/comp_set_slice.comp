#version 460

layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) buffer writeonly buff_slice { 
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance; 
};

layout(binding = 1) uniform Cfg{
    uint instanceCount;
    uint firstInstance; 
} pc;

void main() {

    vertexCount = 4u;
    instanceCount = pc.instanceCount;
    firstVertex = 0u;
    firstInstance = pc.firstInstance;
}
