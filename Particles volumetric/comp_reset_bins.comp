#version 460

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) buffer buff_bin_counts {
    uint binCounts[];
};

layout(std430, set = 0, binding = 1) buffer buff_bin_offsets {
    uint binOffsets[];
};

layout(std430, set = 0, binding = 2) buffer buff_bin_write_counts {
    uint binWriteCounts[];
};

layout(binding = 3) uniform Cfg {
    uint BIN_COUNT;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= BIN_COUNT) return;

    binCounts[gid] = 0u;
    binOffsets[gid] = 0u;
    binWriteCounts[gid] = 0u;
}
