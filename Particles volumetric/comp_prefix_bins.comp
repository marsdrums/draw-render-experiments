#version 460

// BIN_COUNT is intentionally variable. This runs serially in one invocation;
// for 16-512 bins this is tiny compared with sorting 100k particles.
layout(local_size_x = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer buff_bin_counts {
    uint binCounts[];
};

layout(std430, set = 0, binding = 1) buffer buff_bin_offsets {
    uint binOffsets[];
};

layout(std430, set = 0, binding = 2) buffer buff_bin_write_counts {
    uint binWriteCounts[];
};

layout(binding = 3) uniform Cfg {
    uint BIN_COUNT;
};

void main() {
    uint running = 0u;

    for (uint i = 0u; i < BIN_COUNT; ++i) {
        uint c = binCounts[i];
        binOffsets[i] = running;
        binWriteCounts[i] = 0u;
        running += c;
    }
}
