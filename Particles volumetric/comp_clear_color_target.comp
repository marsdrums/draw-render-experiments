#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = 0) uniform writeonly image2D img_color_target;

void main() {

    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(img_color_target);

    if (gid.x >= size.x || gid.y >= size.y) return;

    imageStore(img_color_target, gid, vec4(0.1, 0.1, 0.1, 0.0));
}