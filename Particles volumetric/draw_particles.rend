#version 460

#pragma stage(vertex)

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};


layout(set = 0, binding = 1) uniform Constants {
    mat4 V;
    mat4 P;
    mat4 ligV;
    mat4 ligP;
    vec3 lightDir;
};

layout(location = 0) in vec4 offset;

layout(location = 0) out vec3 col;
layout(location = 1) out vec2 corner;
layout(location = 2) out vec4 ligSpacePos;

void main() {

    Particle p = particles[gl_InstanceIndex];
    corner = offset.xy;
    vec3 finalOffset = offset.xyz*p.rad;
    vec3 vPos = (V * vec4(p.pos, 1.0)).xyz;
    gl_Position = P * vec4(vPos + finalOffset, 1.0);
    vec3 vLigPos = (ligV * vec4(p.pos, 1.0)).xyz;
    ligSpacePos = ligP * vec4(vLigPos + finalOffset, 1.0);
    col.rgb = vec3(1.0);
}

#pragma stage(fragment)

layout(set = 0, binding = 2) uniform sampler2D img_shadow_map;

layout(location = 0) in vec3 col;
layout(location = 1) in vec2 corner;
layout(location = 2) in vec4 ligSpacePos;

layout(location = 0) out vec4 fragColor;

float sampleShadow(vec3 projCoords)
{
    // Outside light frustum — no shadow
    if (projCoords.x < 0.0 || projCoords.x > 1.0 ||
            projCoords.y < 0.0 || projCoords.y > 1.0 ||
            projCoords.z > 1.0) {
        return 0.0;
    }

    return texture(img_shadow_map, projCoords.xy).r;
    //float closestDepth = texture(img_shadow_map, projCoords.xy).r;
    //float currentDepth = projCoords.z;
    //float bias = 0.005;
    //return currentDepth - bias > closestDepth ? 0.0 : 1.0;
}

void main()
{
    float r2 = dot(corner, corner);

    if (r2 > 1.0)
        discard;

    // Perspective divide + map to [0,1] UV space
    vec3 projCoords = ligSpacePos.xyz / ligSpacePos.w;
    projCoords.xy = projCoords.xy * 0.5 + 0.5;
    projCoords.y = 1.0 - projCoords.y; // flip Y for texture coords

    float shadow = sampleShadow(projCoords);

    fragColor.rgb = col * clamp(1 - shadow, 0, 1);
    fragColor.a = smoothstep(0.0, 0.3, 1.0 - r2) * 0.01;
}
