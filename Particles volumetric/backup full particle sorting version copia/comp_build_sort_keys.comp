#version 460

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particles {
    Particle particles[];
};

// Kept at binding 1 for compatibility with the JS binding layout; unused now
// because this shader sorts the full particle set before frustum culling.
layout(std430, set = 0, binding = 1) readonly buffer buff_visible_indices {
    uint visibleIndices[];
};

layout(std430, set = 0, binding = 2) writeonly buffer buff_sort_keys {
    uint keys[];
};

layout(std430, set = 0, binding = 3) writeonly buffer buff_sort_indices {
    uint indices[];
};

// Kept at binding 4 for compatibility; unused for full-particle sorting.
layout(std430, set = 0, binding = 4) readonly buffer buff_inside_counter {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(binding = 5) uniform Cfg {
    uint COUNT;
    vec3 HALF_VECTOR;
    uint DESCENDING;
    float KEY_MIN;
    float KEY_INV_RANGE;
};

// Quantize projected depth into a 16-bit key. The full particle set is sorted
// before frustum culling; culling later preserves this sorted order during compaction.
uint depth_to_key16(float projected) {
    float t = clamp((projected - KEY_MIN) * KEY_INV_RANGE, 0.0, 1.0);
    return uint(t * 65535.0 + 0.5);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= COUNT) return;

    uint particleIndex = gid;
    float projected = dot(HALF_VECTOR, particles[particleIndex].pos);

    uint key = depth_to_key16(projected);
    if (DESCENDING != 0u) {
        key = 65535u - key;
    }

    keys[gid] = key;
    indices[gid] = particleIndex;
}
