#version 460

#pragma stage(vertex)

struct DrawParticle{
    vec4 clipCenter;
    vec4 lightClipCenter;
    // x = radius, y = unused, z = inside flag, w = unused
    vec4 data;
};

layout(std430, set = 0, binding = 0) readonly buffer buff_particle_draw {
    DrawParticle drawParticles[];
};

layout(set = 0, binding = 1) uniform Constants {
    mat4 V;
    mat4 P;
    float ALPHA;
};

layout(location = 0) in vec4 offset;

layout(location = 0) out vec2 corner;
layout(location = 1) out float inside;

void main()
{
    DrawParticle d = drawParticles[gl_InstanceIndex];

    corner = offset.xy;
    inside = d.data.z;

    if (inside < 0.5) {
        gl_Position = vec4(1000.0);
        return;
    }

    // Light-facing billboard: center is already in light clip space; apply only
    // the projected x/y radius offset per vertex.
    gl_Position = d.clipCenter + d.data.x * (offset.x * P[0] + offset.y * P[1]);
}

#pragma stage(fragment)

layout(location = 0) in vec2 corner;
layout(location = 1) in float inside;

layout(location = 0) out vec4 fragColor;

layout(set = 0, binding = 1) uniform Constants {
    mat4 V;
    mat4 P;
    float ALPHA;
};

void main()
{
    float r2 = dot(corner, corner);
    if (inside < 0.5 || r2 > 1.0) {
        discard;
        return;
    }

    fragColor.rgb = vec3(1.0);
    fragColor.a = ALPHA;//smoothstep(0.0, 1.0, 1.0 - r2) * ALPHA;
}
