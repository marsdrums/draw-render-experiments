#version 460
#extension GL_GOOGLE_include_directive : require
#include "c74.noise.funcs.glsl"

layout(local_size_x = 256) in;

struct Particle{
    vec3    pos;
    float   rad;
    vec4    col;
    float   key;
    uint    id;
};

// Storage buffer for particle data
layout(std430, set = 0, binding = 0) buffer writeonly buff_particles {
    Particle particles[]; 
};

layout(binding = 1) uniform Cfg {
    float TIME;
    uint COUNT;
    uint SQRT_COUNT;
    float SCALE;
    vec3 HALF_VECTOR;
    float RADIUS;
};

void main() {

    uint gid = gl_GlobalInvocationID.x;
    if (gid >= COUNT) return;

    Particle p;

    vec3 seed;
    seed.x = float(gid % SQRT_COUNT) * SCALE;
    seed.y = float(gid / SQRT_COUNT) * SCALE;
    seed.z = TIME;
    
    p.pos.x = Normalize(fBmA(seed                  ,  0.5, 2.0, 1., 6.));
    p.pos.y = Normalize(fBmA(seed + vec3(1,2,3)*100,  0.5, 2.0, 1., 6.));
    p.pos.z = Normalize(fBmA(seed + vec3(1,2,3)*200,  0.5, 2.0, 1., 6.));

    p.pos = p.pos*2 - 1;

    uint jittSeed = gid + 999u;
    vec3 jittering = (RandomVec301(jittSeed) - 0.5)*0.01;

    p.pos += jittering;

    p.rad = RADIUS;
    p.col = vec4(sin(float(gid) * vec3(1,2,3))*0.5 + 0.5,1);
    p.id = gid;
    p.key = dot(HALF_VECTOR, p.pos);

    particles[gid] = p;
}