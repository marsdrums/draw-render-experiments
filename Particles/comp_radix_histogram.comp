#version 460

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer buff_sort_keys {
    uint keys[];
};

layout(std430, set = 0, binding = 1) buffer buff_radix_hist {
    uint hist[];
};

layout(std430, set = 0, binding = 2) readonly buffer buff_inside_counter {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(binding = 3) uniform Cfg {
    uint COUNT;
    uint SHIFT;
    uint BLOCK_COUNT;
};

shared uint localHist[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x;
    uint gid = gl_GlobalInvocationID.x;

    localHist[lid] = 0u;
    barrier();

    if (gid < instanceCount) {
        uint digit = (keys[gid] >> SHIFT) & 255u;
        atomicAdd(localHist[digit], 1u);
    }

    barrier();

    hist[lid * BLOCK_COUNT + block] = localHist[lid];
}
